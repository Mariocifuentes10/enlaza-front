# URL base de la API de enlaza-backend
VITE_API_URL=http://localhost:4000

# --- Sentry (monitoreo de errores) ---
# DSN público del proyecto en Sentry. Si se deja vacío, el cliente no inicializa Sentry.
VITE_SENTRY_DSN=
# Entorno reportado a Sentry (development, staging, production).
VITE_SENTRY_ENVIRONMENT=development
# Identificador de release (ej. el hash del commit o la versión de la tag).
VITE_RELEASE=
